<Window x:Class="MindMapApp.EditNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування вузла" Height="500" Width="300" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Текст вузла:"/>
        <TextBox x:Name="NodeTextBox" Margin="0,5,0,10" Height="25"/>

        <TextBlock Text="Колір (HEX):"/>
        <ComboBox x:Name="ColorComboBox" Margin="0,5,0,10" SelectedIndex="0">
            <ComboBoxItem Content="#ADD8E6" Background="#ADD8E6" Tag="Блакитний"/>
            <ComboBoxItem Content="#90EE90" Background="#90EE90" Tag="Зелений"/>
            <ComboBoxItem Content="#FFB6C1" Background="#FFB6C1" Tag="Рожевий"/>
            <ComboBoxItem Content="#FFE4B5" Background="#FFE4B5" Tag="Бежевий"/>
            <ComboBoxItem Content="#FFFFFF" Background="#FFFFFF" Tag="Білий"/>
        </ComboBox>
        <TextBlock Text="Координата Х вузла:"/>
        <TextBox x:Name="NodeXBox" 
             Margin="0,5,0,10" 
             Height="25" 
             PreviewTextInput="NumberValidationTextBox"/>

        <TextBlock Text="Координата Y вузла:"/>
        <TextBox x:Name="NodeYBox" 
             Margin="0,5,0,10" 
             Height="25" 
             PreviewTextInput="NumberValidationTextBox"/>
        <TextBlock Text="Вкладення:" Margin="0,10,0,5" FontWeight="Bold"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="80">
            <WrapPanel x:Name="AttachmentsPanel" Background="#F0F0F0" MinHeight="50"/>
        </ScrollViewer>

        <Button Content="Додати файл..." Click="AddAttachment_Click" Margin="0,5,0,15"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Зберегти" Click="Save_Click" Width="80" Margin="0,0,10,0"/>
            <Button Content="Скасувати" Click="Cancel_Click" Width="80"/>
        </StackPanel>
        
    </StackPanel>
</Window>